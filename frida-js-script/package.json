{
  "name": "prip-frida-js",
  "type": "commonjs",
  "main": "frida.js",
  "dependencies": {
    "frida-java-bridge": "^7.0.13"
  },
  "devDependencies": {
    "@types/frida-gum": "^19.10.0",
    "frida-compile": "^19.0.5",
    "mkdirp": "^3.0.1"
  },
  "scripts": {
    "prebuild": "mkdirp ../src/prip/js",
    "prewatch": "mkdirp ../src/prip/js",
    "build": "frida-compile frida.js -o ../src/prip/js/frida.compiled.js",
    "watch": "frida-compile frida.js -o ../src/prip/js/frida.compiled.js -w"
  }
}
